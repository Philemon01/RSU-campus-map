{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User preferences and role information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "student"] },
        "faculty": { "type": "string" },
        "department": { "type": "string" },
        "level": { "type": "string" },
        "semester": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Timetable": {
      "title": "Timetable Metadata",
      "description": "Master entry for a specific faculty/department timetable.",
      "type": "object",
      "properties": {
        "faculty": { "type": "string" },
        "department": { "type": "string" },
        "level": { "type": "string" },
        "semester": { "type": "string" },
        "creatorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["published", "draft"] }
      },
      "required": ["faculty", "department", "level", "semester", "creatorId", "status"]
    },
    "TimetableSlot": {
      "title": "Class Slot",
      "description": "A single class entry in a timetable.",
      "type": "object",
      "properties": {
        "courseCode": { "type": "string" },
        "courseTitle": { "type": "string" },
        "lecturer": { "type": "string" },
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] },
        "startTime": { "type": "string", "description": "e.g. 08:00" },
        "endTime": { "type": "string", "description": "e.g. 10:00" },
        "venue": { "type": "string" },
        "locationId": { "type": "string", "description": "Matched to campus locations.id" }
      },
      "required": ["courseCode", "day", "startTime", "endTime"]
    },
    "UserLocation": {
      "title": "User Contributed Location",
      "description": "A student or user contributed campus custom location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "officialName": { "type": "string" },
        "aliases": { "type": "array" },
        "coordinates": { "type": "array" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "landmark": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "officialName", "aliases", "coordinates", "type", "ownerId", "createdAt"]
    },
    "CampusEvent": {
      "title": "Campus Event",
      "description": "Official and student community posted events, lectures, matches, and ceremonies.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string", "enum": ["academic", "social", "sports", "conference", "other"] },
        "locationId": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "organizer": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "date", "category", "locationId", "startTime", "endTime", "creatorId", "createdAt"]
    },
    "UserRSVP": {
      "title": "User Event RSVP",
      "description": "RSVP registration for a campus event by a student or user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "eventDate": { "type": "string" },
        "eventLocationId": { "type": "string" },
        "eventStartTime": { "type": "string" },
        "eventEndTime": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "eventId", "createdAt"]
    },
    "LiveShareSession": {
      "title": "Real-Time Location Meetup Share",
      "description": "Opt-in temporary live location beacon shared with friends for campus meetups.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "userEmail": { "type": "string" },
        "coordinates": { "type": "array" },
        "statusNote": { "type": "string" },
        "expiresAt": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "coordinates", "expiresAt", "isActive", "createdAt", "updatedAt"]
    },
    "DeletedEvent": {
      "title": "Deleted Event Marker",
      "description": "Marker tracking deleted event IDs.",
      "type": "object",
      "properties": {
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and settings."
    },
    "/users/{userId}/rsvps/{eventId}": {
      "schema": "UserRSVP",
      "description": "User RSVP list of saved events."
    },
    "/live_shares/{shareId}": {
      "schema": "LiveShareSession",
      "description": "Opt-in ephemeral live location sharing sessions for student meetups."
    },
    "/timetables/{timetableId}": {
      "schema": "Timetable",
      "description": "Timetable metadata."
    },
    "/timetables/{timetableId}/slots/{slotId}": {
      "schema": "TimetableSlot",
      "description": "Individual slots for a timetable."
    },
    "/user_locations/{locationId}": {
      "schema": "UserLocation",
      "description": "Community shared student-defined landmarks and places."
    },
    "/events/{eventId}": {
      "schema": "CampusEvent",
      "description": "Campus events posted and moderated by students and administrators."
    },
    "/deleted_events/{eventId}": {
      "schema": "DeletedEvent",
      "description": "Tombstones for deleted events to sync across clients."
    }
  }
}
